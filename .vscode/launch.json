{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug dspy_react_mcp_100_qa Agent",
            "type": "debugpy",
            "request": "launch",
            "module": "agents.dspy_react_mcp_100_qa.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug dspy_react_mcp_100_qa Agent (with args)",
            "type": "debugpy",
            "request": "launch",
            "module": "agents.dspy_react_mcp_100_qa.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": []
        },
        {
            "name": "Debug Main Entry Point",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
